@prefix atom:  <http://lv2plug.in/ns/ext/atom#> .
@prefix bufsz: <http://lv2plug.in/ns/ext/buf-size#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix urid:  <http://lv2plug.in/ns/ext/urid#> .

<https://github.com/bropple>
	a foaf:Person ;
	foaf:name "Ben Ropple" .

<https://github.com/bropple/BENCsynth>
	# doap:Project as well as lv2:Plugin, because doap:maintainer's domain is
	# a project rather than a plugin - lv2_validate is right to insist, and
	# the two descriptions are of the same thing anyway.
	a lv2:Plugin , lv2:InstrumentPlugin , doap:Project ;
	doap:name "BENCsynth" ;
	doap:license <https://opensource.org/licenses/MIT> ;
	doap:maintainer <https://github.com/bropple> ;
	rdfs:comment "A polyphonic virtual modular synthesizer. Build a rack in the standalone, save a .bencsynth, and load it here." ;

	lv2:requiredFeature urid:map ;
	lv2:optionalFeature lv2:hardRTCapable , bufsz:boundedBlockLength ;
	lv2:extensionData state:interface ;

	# The whole rack travels as one string inside the host's project file.
	# There is no sensible way to express a modular patch as a port list, and
	# trying would mean a fixed set of ports for a thing that has no fixed set
	# of anything.

	lv2:port [
		a lv2:InputPort , atom:AtomPort ;
		atom:bufferType atom:Sequence ;
		atom:supports midi:MidiEvent ;
		lv2:index 0 ;
		lv2:symbol "midi_in" ;
		lv2:name "MIDI In"
	] , [
		a lv2:OutputPort , lv2:AudioPort ;
		lv2:index 1 ;
		lv2:symbol "out_l" ;
		lv2:name "Out L"
	] , [
		a lv2:OutputPort , lv2:AudioPort ;
		lv2:index 2 ;
		lv2:symbol "out_r" ;
		lv2:name "Out R"
	] , [
		# Eight controls that exist whatever the rack contains, because a host
		# needs a fixed parameter list declared before it knows anything about
		# the patch - and a modular's knobs come and go with its modules. What
		# each one does is decided in the rack, by cable, on the MACRO module.
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 3 ;
		lv2:symbol "macro1" ;
		lv2:name "Macro 1" ;
		lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
	] , [
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 4 ;
		lv2:symbol "macro2" ;
		lv2:name "Macro 2" ;
		lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
	] , [
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 5 ;
		lv2:symbol "macro3" ;
		lv2:name "Macro 3" ;
		lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
	] , [
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 6 ;
		lv2:symbol "macro4" ;
		lv2:name "Macro 4" ;
		lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
	] , [
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 7 ;
		lv2:symbol "macro5" ;
		lv2:name "Macro 5" ;
		lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
	] , [
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 8 ;
		lv2:symbol "macro6" ;
		lv2:name "Macro 6" ;
		lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
	] , [
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 9 ;
		lv2:symbol "macro7" ;
		lv2:name "Macro 7" ;
		lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
	] , [
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 10 ;
		lv2:symbol "macro8" ;
		lv2:name "Macro 8" ;
		lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
	] .
